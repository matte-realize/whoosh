# Copy to .env.local (gitignored) and edit. Never commit .env.local.

# Where the dashboard gets rides: "fixtures" (bundled sample data, no key needed)
# or "supabase" (reads the public_rides view).
NEXT_PUBLIC_DATA_SOURCE=fixtures

# Only used when NEXT_PUBLIC_DATA_SOURCE=supabase.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The publishable key (sb_publishable_...). The legacy "anon" key also works in this variable.
# WARNING: the secret key (sb_secret_...) or legacy service_role key must NEVER be put in any
# NEXT_PUBLIC_ variable, or anywhere else in web/. NEXT_PUBLIC_ values are shipped to every browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
