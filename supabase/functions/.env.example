# Crash-alert Edge Function secrets — NAMES ONLY. Never commit real values.
# Set these with `supabase secrets set KEY=value` (see README.md). This file documents which
# secrets the functions read via Deno.env; it must contain placeholders only.
#
# Privacy: provider credentials and the recipient-hash pepper exist ONLY as Edge Function
# secrets in Role C's environment — never in Git, the iOS app, or any client.

# --- Supabase (service role for function writes; anon + URL for user-scoped reads) ----------
# SUPABASE_URL and SUPABASE_ANON_KEY are injected automatically in deployed functions; set them
# only for local `supabase functions serve`.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Twilio (SMS provider) ------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Provide ONE sender: a verified From number OR a Messaging Service SID.
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# How long Twilio keeps trying before giving up (seconds). Default 900 (15 min).
TWILIO_VALIDITY_PERIOD_SECONDS=900

# --- Crash-alert backend --------------------------------------------------------------------
# Keyed HMAC pepper for hashing recipient numbers (contract §9). Rotate = counters reset.
RECIPIENT_HASH_PEPPER=generate-a-long-random-secret
# Public base URL the provider posts delivery callbacks to. No trailing slash.
# e.g. https://YOUR-PROJECT-REF.functions.supabase.co  -> the function appends /sms-status-callback
CALLBACK_BASE_URL=https://YOUR-PROJECT-REF.functions.supabase.co
# Optional environment kill switch (overrides crash_alert_config.enabled). "1" or "true" = off.
# CRASH_ALERTS_DISABLED=0
