# Crash-alert Edge Function secrets. Placeholders only: never commit real values.
# Local:  cp supabase/functions/.env.example supabase/functions/.env  (gitignored), then
#         supabase functions serve --env-file supabase/functions/.env
# Hosted: supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase automatically.

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-me
# A Messaging Service SID (MG...) or a +1 sender number.
TWILIO_FROM=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The public URL Twilio calls with delivery updates (must match exactly for signatures).
SMS_STATUS_CALLBACK_URL=https://YOUR-PROJECT-REF.supabase.co/functions/v1/sms-status-callback
# At least 32 random characters, for example: openssl rand -hex 32
CRASH_ALERT_PEPPER=replace-with-32-or-more-random-characters

